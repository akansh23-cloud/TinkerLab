# TinkerLab Phase 12.2.1 — SINGLE VERCEL PROJECT
# Add these variables to the existing `tinker-lab` Vercel project.
# The frontend talks to FastAPI at same-origin /api; no public API hostname is required.

# Required: Neon/Postgres connection used by the FastAPI service.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# Required for the current demo tenant. This matches the idempotent bootstrap service.
NEXT_PUBLIC_ORGANISATION_ID=0b5ec369-282c-57b5-9781-471f818a07c3

# Server-side Materials Project integration.
MATERIALS_PROJECT_API_KEY=<YOUR_MATERIALS_PROJECT_API_KEY>
MATERIALS_PROJECT_API_BASE_URL=https://api.materialsproject.org

# Optional provider.
EPA_COMPTOX_API_KEY=<OPTIONAL_EPA_COMPTOX_KEY>

LOG_LEVEL=INFO
ENVIRONMENT=production
API_VERSION=0.12.2.1

# Same-origin production does NOT require these. Remove stale values from Vercel unless you
# intentionally run a split frontend/backend deployment.
# NEXT_PUBLIC_API_MODE=external
# NEXT_PUBLIC_API_BASE_URL=https://your-separate-api.example.com

# CORS is only relevant to deliberately split/local deployments. Same-origin /api does not need it.
CORS_ORIGINS=http://localhost:3000
