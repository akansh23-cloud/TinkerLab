# -----------------------------------------------------------------------------
# TinkerLab Phase 12.2 - Vercel/Neon deployment environment
# Generated for the connected cloud14 deployment.
# Import SERVER variables into the API project only and NEXT_PUBLIC variables
# into the Web project only.
# -----------------------------------------------------------------------------

# === API / SERVER (apps/api) ===
DATABASE_URL=<FILL_NEON_DATABASE_URL>
CORS_ORIGINS=https://tinker-lab-sandy.vercel.app,https://tinker-lab-cloud14.vercel.app,https://tinker-lab-git-develop-cloud14.vercel.app
LOG_LEVEL=INFO
ENVIRONMENT=production
APP_NAME=TinkerLab API
API_VERSION=0.12.2

# External scientific connectors - fill these when available.
MATERIALS_PROJECT_API_KEY=<FILL_MATERIALS_PROJECT_API_KEY>
MATERIALS_PROJECT_API_BASE_URL=https://api.materialsproject.org
EPA_COMPTOX_API_KEY=<FILL_EPA_COMPTOX_API_KEY>

# Optional local/HPC solver paths. Leave unset on Vercel.
# TINKERLAB_ARTIFACT_STORE=/persistent/path/to/tinkerlab/artifacts
# TINKERLAB_SYSTEM_PSEUDO_DIR=/usr/share/espresso/pseudo

# === WEB / CLIENT (apps/web) ===
NEXT_PUBLIC_API_BASE_URL=<FILL_PHASE12_2_API_URL>
NEXT_PUBLIC_ORGANISATION_ID=0b5ec369-282c-57b5-9781-471f818a07c3

# Optional non-public server base URL, if another tool consumes it.
API_BASE_URL=<FILL_PHASE12_2_API_URL>
