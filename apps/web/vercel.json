{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "python_backend/**",
      "excludeFiles": "{node_modules/**,.next/**,coverage/**,**/__pycache__/**,**/*.pyc,**/__tests__/**,**/*.test.ts,**/*.test.tsx}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__tinker_path="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__tinker_path=:path*"
    }
  ]
}
